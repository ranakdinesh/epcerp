{
  "name": "epcerp-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build --webpack",
    "start": "next start --port 3001",
    "lint": "eslint",
    "test:control": "node --test tests/project-control.test.mjs",
    "test:delivery": "node --test tests/delivery-plan.test.mjs",
    "test:isolation": "node --test tests/go-isolation.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "prebuild": "node scripts/prepare-pdf-viewer.mjs",
    "predev": "node scripts/prepare-pdf-viewer.mjs",
    "test:auth": "node --conditions=react-server --import tsx --test tests/server-auth/*.test.ts",
    "test:master": "node --conditions=react-server --import tsx --test tests/server-master/*.test.ts",
    "test:tsc": "bash scripts/verify-tsc.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@heroicons/react": "^2.2.0",
    "@noble/hashes": "2.0.1",
    "argon2": "^0.45.2",
    "fflate": "0.8.3",
    "next": "16.3.4",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
