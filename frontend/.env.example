# Private development settings. Never commit .env.local or real credentials.
# Use the existing epcERP database and keys when upgrading an installation.
EPCERP_DATABASE_URL=postgresql://epcerp:CHANGE_ME@127.0.0.1:5439/epcerp
EPCERP_ENVIRONMENT=development
EPCERP_DEVELOPMENT_HTTP=true
# Generate new-install keys with openssl rand -hex 48 / openssl rand -hex 32.
VTPL_JWT_SECRET_KEY=
VTPL_JWT_ISSUER=epcERP
VTPL_JWT_AUDIENCE=epcERP-api
EPCERP_IMAGE_ENCRYPTION_KEY=
EPCERP_SUPPLIER_DOCUMENT_KEY=
EPCERP_DOCUMENT_READING_KEY=
VTPL_STORAGE_ENDPOINT=127.0.0.1:9002
VTPL_STORAGE_ACCESS_KEY=epcerp_storage
VTPL_STORAGE_SECRET_KEY=
VTPL_STORAGE_BUCKET=epcerp-documents
VTPL_STORAGE_SECURE=false
# Must be an absolute, owner-only directory (mode 0700).
EPCERP_DOCUMENT_PACKAGE_ROOT=
# Bootstrap applies only to a new database; existing passwords are retained.
VTPL_BOOTSTRAP_SUPERADMIN_USERNAME=superadmin
VTPL_BOOTSTRAP_SUPERADMIN_EMAIL=admin@epcerp.local
VTPL_BOOTSTRAP_SUPERADMIN_PASSWORD=
EPCERP_EMAIL_DELIVERY_ENABLED=false
EPCERP_TSC_CLOUD_APPROVED=false
EPCERP_TSC_GEMINI_API_KEY=
EPCERP_TSC_OPENAI_API_KEY=
